# ==============================================================================
# echosh-labs / amra-treasury Configuration (Port 8050)
# ==============================================================================

PORT=8050
SERVICE_NAME=amra-treasury
ENV=development
BOLT_DB_PATH=.data/amra-treasury-dev.db

# YouTube Sovereign Studio & Analytics API
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URL=http://localhost:8050/api/v1/youtube/auth/callback

# AMRA Financial Subscriptions & Stripe Ingest
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Cloud Infrastructure Burn Rate & Margin
GCLOUD_PROJECT_ID=your-gcloud-project-id
GCLOUD_BILLING_ID=your-gcloud-billing-id
